# Supabase. For local dev run `supabase start` and copy the values it prints
# (API URL -> NEXT_PUBLIC_SUPABASE_URL, anon key, service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: only for the Telegram bot, webhooks and cron
# (src/server/db createServiceClient). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Origin used in magic-link redirects; defaults to the request host.
NEXT_PUBLIC_SITE_URL=

# LLM used by the receipt interpretation layer (src/server/interpret).
# Server-only: never exposed to the browser. Any OpenAI-compatible API works;
# LLM_BASE_URL is the API root. LLM_BASE_URL, LLM_API_KEY and LLM_MODEL must all
# be set or POST /api/interpret answers 503. LLM_FALLBACK_MODEL is optional: it
# is tried once if the primary model errors or keeps returning invalid output.
# Build and tests do not need any of them.
LLM_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
LLM_API_KEY=
LLM_MODEL=x-test-2
LLM_FALLBACK_MODEL=qwen3.8:27b
